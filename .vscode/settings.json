{
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.DS_Store": true,
    "**/.venv": true,
    "**/node_modules": true,
    "**/.serena": true,
    "**/.playwright-mcp": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/.serena/**": true,
    "**/.playwright-mcp/**": true,
    "**/backend/secrets/**": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/.serena": true,
    "**/.playwright-mcp": true
  }
}
