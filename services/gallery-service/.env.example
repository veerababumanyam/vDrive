# ===========================================
# vDrive Gallery Service Environment Variables
# ===========================================

# Service Configuration
SERVICE_NAME=gallery-service
SERVICE_PORT=8004
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://vdrive_user:vdrive_pass@postgres:5432/vdrive_db

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=gallery-service
KAFKA_TOPIC_GALLERY_PUBLISHED=gallery.published
KAFKA_TOPIC_WATERMARK_APPLIED=gallery.watermark.applied

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=vdrive-assets
R2_ENDPOINT_URL=https://{account_id}.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://assets.vdrive.io

# Security
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Backend API (for auth validation)
BACKEND_API_URL=http://backend:8000

# Worker Configuration
WORKER_CONCURRENCY=4
WORKER_MAX_RETRIES=3
BATCH_SIZE=100

# Watermark Defaults
DEFAULT_WATERMARK_OPACITY=0.5
DEFAULT_WATERMARK_POSITION=center
MAX_WATERMARK_SIZE_MB=5

# Performance
IMAGE_PROCESSING_TIMEOUT=30
MAX_IMAGE_DIMENSION=4096
THUMBNAIL_SIZE=800

# Monitoring
PROMETHEUS_PORT=9090
SENTRY_DSN=
