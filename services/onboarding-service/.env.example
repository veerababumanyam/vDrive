# RawDrive Onboarding Service - Environment Configuration
# Copy this file to .env and update values for your environment

# ===========================================
# Service Identity
# ===========================================
SERVICE_NAME=onboarding-service
SERVICE_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=8006

# ===========================================
# Database Configuration
# ===========================================
# For local development with Docker
DATABASE_URL=postgresql+asyncpg://RawDrive:RawDrive_dev_password@localhost:5432/RawDrive

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# JWT Authentication
# ===========================================
# IMPORTANT: Generate a secure secret for production (min 32 chars)
# Example: openssl rand -hex 32
JWT_SECRET=dev_secret_key_32_chars_minimum__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Password Security (Argon2id)
# ===========================================
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ===========================================
# Google OAuth (optional)
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8006/api/v1/onboarding/oauth/google/callback

# ===========================================
# Cloudflare Turnstile (optional)
# ===========================================
# Get keys from: https://dash.cloudflare.com/turnstile
CLOUDFLARE_TURNSTILE_SECRET=

# ===========================================
# Kafka Event Bus
# ===========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===========================================
# External Services
# ===========================================
NOTIFICATION_SERVICE_URL=http://localhost:8005
BILLING_SERVICE_URL=http://localhost:8013

# ===========================================
# Application URLs
# ===========================================
APP_URL=http://localhost:3000
WEBSITE_URL=http://localhost:8011

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_REGISTRATION_MAX=5
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=900
RATE_LIMIT_RESEND_MAX=3
RATE_LIMIT_RESEND_WINDOW_SECONDS=3600

# ===========================================
# Trial Configuration
# ===========================================
TRIAL_DURATION_DAYS=14
TRIAL_STORAGE_GB=100
TRIAL_AI_CREDITS=500
TRIAL_TIER=pro
