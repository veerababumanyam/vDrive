# vDrive Export Service - Environment Configuration
# Copy this file to .env and update values for your environment

# ===========================================
# Service Identity
# ===========================================
SERVICE_NAME=export-service
SERVICE_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=8009

# ===========================================
# Database Configuration
# ===========================================
# For local development with Docker
DATABASE_URL=postgresql+asyncpg://vDrive:vDrive_dev_password@localhost:5432/vDrive

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# JWT Authentication
# ===========================================
# IMPORTANT: Generate a secure secret for production (min 32 chars)
# Example: openssl rand -hex 32
JWT_SECRET=dev_secret_key_32_chars_minimum__
JWT_ALGORITHM=HS256

# ===========================================
# Kafka Event Bus
# ===========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===========================================
# Celery Configuration
# ===========================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===========================================
# Cloudflare R2 Storage
# ===========================================
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vDrive-exports
R2_PUBLIC_URL=https://exports.vdrive.io

# ===========================================
# Export Configuration
# ===========================================
# Maximum export size in bytes (10GB default)
MAX_EXPORT_SIZE_BYTES=10737418240
# Export file retention in hours (72 hours = 3 days)
EXPORT_RETENTION_HOURS=72
# Maximum concurrent export jobs per workspace
MAX_CONCURRENT_EXPORTS=2

# ===========================================
# Application URLs
# ===========================================
APP_URL=http://localhost:3000
WEBSITE_URL=http://localhost:8020

# ===========================================
# External Services
# ===========================================
BACKEND_SERVICE_URL=http://localhost:8000
GALLERY_SERVICE_URL=http://localhost:8004

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_EXPORT_MAX=5
RATE_LIMIT_EXPORT_WINDOW_SECONDS=3600
