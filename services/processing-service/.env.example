# ===========================================
# RawDrive Processing Service Environment Variables
# ===========================================
# Copy this file to .env and update values for your environment
# For full environment reference, see: infrastructure/docker/.env.example

# Service Identity
SERVICE_NAME=processing-service
SERVICE_VERSION=1.0.0
APP_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://RawDrive:RawDrive_dev_password@postgres:5432/RawDrive

# Redis
REDIS_URL=redis://redis:6379/1
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECT_TIMEOUT=5
REDIS_READ_TIMEOUT=10
REDIS_SSL_ENABLED=false

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=processing-service
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false

# Cloudflare R2 Storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=RawDrive-assets
R2_PUBLIC_URL=https://assets.yourdomain.com

# Encryption
ENCRYPTION_MASTER_KEY=your_32_byte_encryption_key_here

# Google Cloud Vision (optional)
GOOGLE_CLOUD_VISION_CREDENTIALS=
GOOGLE_CLOUD_VISION_ENABLED=false
GOOGLE_CLOUD_VISION_RATE_LIMIT=1000

# Image Processing Configuration
THUMBNAIL_SIZE=300
PREVIEW_SIZE=1200
LQIP_SIZE=20
WEBP_QUALITY=85
THUMBNAIL_QUALITY=80
LQIP_QUALITY=60

# Task Processing
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT_SECONDS=300
MAX_RETRIES=3

# Monitoring
PROMETHEUS_PORT=8010
