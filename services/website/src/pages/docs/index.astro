---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { getCollection } from 'astro:content';
import { generateBreadcrumbSchema, generateOrganizationSchema } from '@/utils/schema';

const docs = (await getCollection('docs'))
  .filter((doc) => !doc.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// Group docs by section
const sections = docs.reduce((acc, doc) => {
  const section = doc.data.section || 'General';
  if (!acc[section]) {
    acc[section] = [];
  }
  acc[section].push(doc);
  return acc;
}, {} as Record<string, typeof docs>);

const schemas = [
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Documentation' },
  ]),
];
---

<BaseLayout
  title="Documentation"
  description="Learn how to use vDrive with our comprehensive documentation and guides. Get started with galleries, AI features, and API integration."
>
  <JsonLd slot="head" schema={schemas} />
  <section class="section">
    <div class="container-lg">
      <div class="grid gap-12 lg:grid-cols-4">
        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <nav class="sticky top-24" aria-label="Documentation navigation">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-warm-400">
              Documentation
            </h2>
            <ul class="mt-4 space-y-1" role="list">
              {Object.entries(sections).map(([section, items]) => (
                <li>
                  <span class="block py-2 text-sm font-medium text-neutral-900 dark:text-white">
                    {section}
                  </span>
                  <ul
                    class="ml-3 space-y-1 border-l border-neutral-200 dark:border-warm-800"
                    role="list"
                  >
                    {items.map((doc) => (
                      <li>
                        <a
                          href={`/docs/${doc.slug}`}
                          class="block py-1 pl-4 text-sm text-neutral-600 hover:text-neutral-900 dark:text-warm-400 dark:hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 rounded"
                        >
                          {doc.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </nav>
        </aside>

        <!-- Main Content -->
        <main class="lg:col-span-3">
          <div class="max-w-3xl">
            <h1 class="text-4xl font-bold tracking-tight text-neutral-900 dark:text-white">
              Documentation
            </h1>
            <p class="mt-4 text-lg text-neutral-600 dark:text-warm-400">
              Everything you need to know about using vDrive. From getting started
              to advanced features.
            </p>

            <!-- Quick Links -->
            <div class="mt-12 grid gap-6 sm:grid-cols-2" role="list" aria-label="Quick links to documentation sections">
              <a href="/docs/introduction" class="card-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 rounded-xl" role="listitem">
                <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary-100 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </div>
                <h3 class="font-semibold text-neutral-900 dark:text-white">
                  Getting Started
                </h3>
                <p class="mt-1 text-sm text-neutral-600 dark:text-warm-400">
                  Learn the basics of vDrive and set up your first workspace.
                </p>
              </a>

              <a href="/docs/galleries" class="card-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 rounded-xl" role="listitem">
                <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary-100 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <h3 class="font-semibold text-neutral-900 dark:text-white">
                  Client Galleries
                </h3>
                <p class="mt-1 text-sm text-neutral-600 dark:text-warm-400">
                  Create and share beautiful galleries with your clients.
                </p>
              </a>

              <a href="/docs/ai-features" class="card-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 rounded-xl" role="listitem">
                <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary-100 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                </div>
                <h3 class="font-semibold text-neutral-900 dark:text-white">
                  AI Features
                </h3>
                <p class="mt-1 text-sm text-neutral-600 dark:text-warm-400">
                  Leverage AI for auto-tagging, face recognition, and more.
                </p>
              </a>

              <a href="/docs/api" class="card-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 rounded-xl" role="listitem">
                <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary-100 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                </div>
                <h3 class="font-semibold text-neutral-900 dark:text-white">
                  API Reference
                </h3>
                <p class="mt-1 text-sm text-neutral-600 dark:text-warm-400">
                  Integrate vDrive with your existing tools and workflows.
                </p>
              </a>
            </div>
          </div>
        </main>
      </div>
    </div>
  </section>
</BaseLayout>
