---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import FAQSection from '@/components/landing/FAQSection.astro';
import CTASection from '@/components/landing/CTASection.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { pricingPlans } from '@/data/pricing';
import { formatINR } from '@/utils/currency';
import { generateProductSchema, generateFAQSchema, generateBreadcrumbSchema } from '@/utils/schema';
import { faqData } from '@/data/faq';

const APP_URL = import.meta.env.APP_URL || 'https://app.RawDrive.io';

// Generate JSON-LD schemas for pricing page
const schemas = [
  ...pricingPlans.filter((p) => p.priceINR !== null).map((plan) => generateProductSchema(plan)),
  generateFAQSchema(faqData),
  generateBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Pricing' },
  ]),
];
---

<BaseLayout
  title="Pricing"
  description="Simple, transparent pricing for RawDrive. Plans start at free with pay-as-you-grow pricing in INR. Start your 14-day free trial today."
>
  <JsonLd slot="head" schema={schemas} />

  <!-- Hero -->
  <section class="section-lg bg-gradient-to-b from-primary-50 to-white dark:from-neutral-900 dark:to-neutral-950">
    <div class="container-lg">
      <div class="mx-auto max-w-3xl text-center">
        <span class="badge badge-primary">Pricing</span>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-5xl">
          Plans that grow with your business
        </h1>
        <p class="mt-6 text-lg text-neutral-600 dark:text-warm-400">
          Start with a 14-day free trial. No credit card required.
          Choose the plan that fits your needs.
        </p>

        <!-- Billing Toggle -->
        <div class="mt-8 flex items-center justify-center gap-4">
          <span class="text-sm font-medium text-neutral-600 dark:text-warm-400" id="monthly-label">Monthly</span>
          <button
            type="button"
            id="billing-toggle"
            class="relative inline-flex h-6 w-11 items-center rounded-full bg-primary-500 transition-colors"
            role="switch"
            aria-checked="true"
            aria-label="Toggle between monthly and yearly billing"
          >
            <span class="sr-only">Toggle billing period</span>
            <span
              id="toggle-dot"
              class="inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform translate-x-6"
            ></span>
          </button>
          <span class="text-sm font-medium text-neutral-900 dark:text-white" id="yearly-label">
            Yearly
            <span class="ml-1 rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700 dark:bg-green-900/30 dark:text-green-400">
              Save 17%
            </span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- All Pricing Cards -->
  <section class="section bg-white dark:bg-warm-950">
    <div class="container-lg">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {pricingPlans.map((plan) => (
          <div class={`relative rounded-2xl border p-6 ${plan.isPopular ? 'border-primary-500 shadow-lg shadow-primary-500/10 lg:scale-105' : 'border-neutral-200 dark:border-warm-800'}`}>
            {plan.isPopular && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                <span class="rounded-full bg-primary-500 px-3 py-1 text-xs font-medium text-white">
                  Most Popular
                </span>
              </div>
            )}

            <div>
              <h3 class="text-lg font-semibold text-neutral-900 dark:text-white">
                {plan.name}
              </h3>
              <p class="mt-1 text-sm text-neutral-600 dark:text-warm-400 min-h-[40px]">
                {plan.description}
              </p>
            </div>

            <div class="mt-4">
              {plan.priceINR !== null ? (
                <div class="flex items-baseline gap-1">
                  <span class="text-3xl font-bold text-neutral-900 dark:text-white price-monthly" data-price={plan.priceINR}>
                    {plan.priceINR === 0 ? 'Free' : formatINR(plan.priceINR)}
                  </span>
                  <span class="text-3xl font-bold text-neutral-900 dark:text-white price-yearly hidden" data-price={plan.priceINRAnnual ? Math.round(plan.priceINRAnnual / 12) : 0}>
                    {plan.priceINR === 0 ? 'Free' : formatINR(plan.priceINRAnnual ? Math.round(plan.priceINRAnnual / 12) : 0)}
                  </span>
                  {plan.priceINR !== 0 && <span class="text-sm text-neutral-500">/mo</span>}
                </div>
              ) : (
                <div class="text-3xl font-bold text-neutral-900 dark:text-white">
                  Custom
                </div>
              )}
              {plan.priceINRAnnual && plan.priceINR !== 0 && (
                <p class="mt-1 text-xs text-neutral-500 billing-note-yearly hidden">
                  Billed annually ({formatINR(plan.priceINRAnnual)}/year)
                </p>
              )}
            </div>

            <!-- Storage & Limits -->
            <div class="mt-4 space-y-2 text-sm">
              <div class="flex items-center gap-2 text-neutral-600 dark:text-warm-400">
                <svg class="h-4 w-4 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
                </svg>
                <span>{plan.storageGB === null ? 'Unlimited storage' : `${plan.storageGB >= 1000 ? `${plan.storageGB / 1000} TB` : `${plan.storageGB} GB`} storage`}</span>
              </div>
              <div class="flex items-center gap-2 text-neutral-600 dark:text-warm-400">
                <svg class="h-4 w-4 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span>{plan.galleries === null ? 'Unlimited galleries' : `${plan.galleries} galleries`}</span>
              </div>
              <div class="flex items-center gap-2 text-neutral-600 dark:text-warm-400">
                <svg class="h-4 w-4 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>{plan.clients === null ? 'Unlimited clients' : `${plan.clients} clients`}</span>
              </div>
            </div>

            <ul class="mt-4 space-y-2 text-sm">
              {plan.features.slice(3).map((feature) => (
                <li class="flex items-start gap-2">
                  <svg class="h-4 w-4 flex-shrink-0 text-primary-500 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-neutral-600 dark:text-warm-400">
                    {feature}
                  </span>
                </li>
              ))}
            </ul>

            <a
              href={plan.priceINR === null ? '/contact?plan=enterprise' : `${APP_URL}${plan.ctaLink}`}
              class={`mt-6 block w-full rounded-lg py-2.5 text-center text-sm font-medium transition-colors ${plan.isPopular ? 'bg-primary-500 text-white hover:bg-primary-600' : 'bg-neutral-100 text-neutral-900 hover:bg-neutral-200 dark:bg-warm-800 dark:text-white dark:hover:bg-warm-700'}`}
            >
              {plan.ctaText}
            </a>
          </div>
        ))}
      </div>

      <!-- Enterprise Callout -->
      <div class="mt-16 rounded-2xl bg-gradient-to-r from-primary-600 to-accent-600 p-8 text-center text-white md:p-12">
        <h2 class="text-2xl font-bold md:text-3xl">Need a custom solution?</h2>
        <p class="mt-4 text-primary-100 max-w-2xl mx-auto">
          For large studios, agencies, or custom requirements, our Enterprise plan offers unlimited everything plus dedicated support, custom integrations, and SLA guarantees.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact?plan=enterprise" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 font-medium text-primary-600 transition-all hover:bg-primary-50">
            Contact Sales
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href="/docs" class="inline-flex items-center gap-2 rounded-lg border border-white/30 px-6 py-3 font-medium text-white transition-all hover:bg-white/10">
            View Documentation
          </a>
        </div>
      </div>
    </div>
  </section>

  <FAQSection />
  <CTASection />
</BaseLayout>

<script>
  function initPricingToggle() {
    const toggle = document.getElementById('billing-toggle');
    const toggleDot = document.getElementById('toggle-dot');
    const monthlyPrices = document.querySelectorAll('.price-monthly');
    const yearlyPrices = document.querySelectorAll('.price-yearly');
    const yearlyNotes = document.querySelectorAll('.billing-note-yearly');
    const monthlyLabel = document.getElementById('monthly-label');
    const yearlyLabel = document.getElementById('yearly-label');

    let isYearly = true;

    toggle?.addEventListener('click', () => {
      isYearly = !isYearly;

      // Update aria-checked for screen readers (WCAG compliance)
      toggle?.setAttribute('aria-checked', String(isYearly));

      if (isYearly) {
        toggleDot?.classList.add('translate-x-6');
        toggleDot?.classList.remove('translate-x-1');
        monthlyPrices.forEach((el) => el.classList.add('hidden'));
        yearlyPrices.forEach((el) => el.classList.remove('hidden'));
        yearlyNotes.forEach((el) => el.classList.remove('hidden'));
        monthlyLabel?.classList.remove('text-neutral-900', 'dark:text-white');
        monthlyLabel?.classList.add('text-neutral-600', 'dark:text-warm-400');
        yearlyLabel?.classList.add('text-neutral-900', 'dark:text-white');
        yearlyLabel?.classList.remove('text-neutral-600', 'dark:text-warm-400');
      } else {
        toggleDot?.classList.remove('translate-x-6');
        toggleDot?.classList.add('translate-x-1');
        monthlyPrices.forEach((el) => el.classList.remove('hidden'));
        yearlyPrices.forEach((el) => el.classList.add('hidden'));
        yearlyNotes.forEach((el) => el.classList.add('hidden'));
        monthlyLabel?.classList.add('text-neutral-900', 'dark:text-white');
        monthlyLabel?.classList.remove('text-neutral-600', 'dark:text-warm-400');
        yearlyLabel?.classList.remove('text-neutral-900', 'dark:text-white');
        yearlyLabel?.classList.add('text-neutral-600', 'dark:text-warm-400');
      }
    });
  }

  // Initialize on page load
  initPricingToggle();

  // Re-initialize on Astro view transitions
  document.addEventListener('astro:after-swap', initPricingToggle);
</script>
