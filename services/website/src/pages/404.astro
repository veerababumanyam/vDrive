---
import BaseLayout from '@/components/layout/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
  noIndex={true}
>
  <section class="section-lg flex min-h-[60vh] items-center">
    <div class="container-lg">
      <div class="mx-auto max-w-2xl text-center">
        <!-- 404 Illustration -->
        <div class="mb-8 flex justify-center">
          <div class="relative">
            <span class="text-[150px] font-bold text-neutral-100 dark:text-neutral-800 leading-none">
              404
            </span>
            <div class="absolute inset-0 flex items-center justify-center">
              <svg
                class="h-24 w-24 text-primary-500"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
            </div>
          </div>
        </div>

        <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-4xl">
          Page not found
        </h1>
        <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
          Sorry, we couldn't find the page you're looking for. It might have been moved or deleted.
        </p>

        <!-- Navigation Options -->
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/" class="btn btn-primary">
            <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Go to Homepage
          </a>
          <a href="/docs" class="btn btn-outline">
            View Documentation
          </a>
        </div>

        <!-- Helpful Links -->
        <div class="mt-12 border-t border-neutral-200 pt-8 dark:border-neutral-800">
          <p class="text-sm font-medium text-neutral-900 dark:text-white mb-4">
            Popular pages:
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/features" class="text-sm text-primary-500 hover:text-primary-600 hover:underline">
              Features
            </a>
            <a href="/pricing" class="text-sm text-primary-500 hover:text-primary-600 hover:underline">
              Pricing
            </a>
            <a href="/blog" class="text-sm text-primary-500 hover:text-primary-600 hover:underline">
              Blog
            </a>
            <a href="/docs" class="text-sm text-primary-500 hover:text-primary-600 hover:underline">
              Documentation
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
