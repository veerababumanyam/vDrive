---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { generateBreadcrumbSchema, generateOrganizationSchema } from '@/utils/schema';

const APP_URL = import.meta.env.APP_URL || 'https://app.vdrive.io';

// Get plan from URL params for pre-selection
const url = Astro.url;
const plan = url.searchParams.get('plan') || '';

const schemas = [
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Contact' },
  ]),
];

const contactReasons = [
  { value: '', label: 'Select a reason...' },
  { value: 'enterprise', label: 'Enterprise Sales Inquiry' },
  { value: 'demo', label: 'Request a Demo' },
  { value: 'partnership', label: 'Partnership Opportunity' },
  { value: 'support', label: 'Customer Support' },
  { value: 'press', label: 'Press & Media' },
  { value: 'other', label: 'Other' },
];
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with the vDrive team. Contact us for enterprise sales, demos, partnerships, or support."
>
  <JsonLd slot="head" schema={schemas} />

  <section class="section-lg bg-gradient-to-b from-primary-50 to-white dark:from-neutral-900 dark:to-neutral-950">
    <div class="container-lg">
      <div class="mx-auto max-w-4xl">
        <div class="text-center">
          <span class="badge badge-primary">Contact</span>
          <h1 class="mt-4 text-4xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-5xl">
            Let's talk about your needs
          </h1>
          <p class="mt-6 text-lg text-neutral-600 dark:text-neutral-400">
            Have questions about vDrive? Want to discuss enterprise solutions?
            We'd love to hear from you.
          </p>
        </div>

        <div class="mt-16 grid gap-12 lg:grid-cols-2">
          <!-- Contact Form -->
          <div class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
            <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">
              Send us a message
            </h2>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
              Fill out the form and we'll get back to you within 24 hours.
            </p>

            <form
              class="mt-6 space-y-6"
              action={`${APP_URL}/api/contact`}
              method="POST"
              data-contact-form
            >
              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="firstName" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
                    First name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    required
                    autocomplete="given-name"
                    class="mt-1 block w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-neutral-900 placeholder-neutral-400 transition-colors focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white dark:placeholder-neutral-500"
                    placeholder="John"
                  />
                </div>
                <div>
                  <label for="lastName" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
                    Last name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="lastName"
                    name="lastName"
                    required
                    autocomplete="family-name"
                    class="mt-1 block w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-neutral-900 placeholder-neutral-400 transition-colors focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white dark:placeholder-neutral-500"
                    placeholder="Doe"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
                  Email <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="mt-1 block w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-neutral-900 placeholder-neutral-400 transition-colors focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white dark:placeholder-neutral-500"
                  placeholder="john@example.com"
                />
              </div>

              <div>
                <label for="company" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
                  Company
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  autocomplete="organization"
                  class="mt-1 block w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-neutral-900 placeholder-neutral-400 transition-colors focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white dark:placeholder-neutral-500"
                  placeholder="Your company name"
                />
              </div>

              <div>
                <label for="reason" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
                  Reason for contact <span class="text-red-500">*</span>
                </label>
                <select
                  id="reason"
                  name="reason"
                  required
                  class="mt-1 block w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-neutral-900 transition-colors focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white"
                >
                  {contactReasons.map((option) => (
                    <option
                      value={option.value}
                      selected={plan === option.value || (plan === 'enterprise' && option.value === 'enterprise')}
                    >
                      {option.label}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
                  Message <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="4"
                  class="mt-1 block w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-neutral-900 placeholder-neutral-400 transition-colors focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white dark:placeholder-neutral-500"
                  placeholder="Tell us how we can help..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full rounded-lg bg-primary-500 px-6 py-3 font-medium text-white transition-colors hover:bg-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-neutral-900"
              >
                Send Message
              </button>
            </form>
          </div>

          <!-- Contact Info -->
          <div class="space-y-8">
            <!-- Quick Links -->
            <div class="rounded-2xl border border-neutral-200 bg-white p-8 dark:border-neutral-800 dark:bg-neutral-900">
              <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">
                Quick links
              </h2>
              <ul class="mt-6 space-y-4">
                <li>
                  <a href="/docs" class="flex items-start gap-4 group">
                    <div class="rounded-lg bg-primary-100 p-2 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400">
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                      </svg>
                    </div>
                    <div>
                      <span class="font-medium text-neutral-900 group-hover:text-primary-500 dark:text-white">Documentation</span>
                      <p class="text-sm text-neutral-600 dark:text-neutral-400">Get started with our comprehensive guides</p>
                    </div>
                  </a>
                </li>
                <li>
                  <a href="/pricing" class="flex items-start gap-4 group">
                    <div class="rounded-lg bg-primary-100 p-2 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400">
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>
                    <div>
                      <span class="font-medium text-neutral-900 group-hover:text-primary-500 dark:text-white">Pricing</span>
                      <p class="text-sm text-neutral-600 dark:text-neutral-400">View our plans and pricing options</p>
                    </div>
                  </a>
                </li>
                <li>
                  <a href="/blog" class="flex items-start gap-4 group">
                    <div class="rounded-lg bg-primary-100 p-2 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400">
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                      </svg>
                    </div>
                    <div>
                      <span class="font-medium text-neutral-900 group-hover:text-primary-500 dark:text-white">Blog</span>
                      <p class="text-sm text-neutral-600 dark:text-neutral-400">Tips and insights for photographers</p>
                    </div>
                  </a>
                </li>
              </ul>
            </div>

            <!-- Office Info -->
            <div class="rounded-2xl border border-neutral-200 bg-white p-8 dark:border-neutral-800 dark:bg-neutral-900">
              <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">
                Contact information
              </h2>
              <ul class="mt-6 space-y-4">
                <li class="flex items-center gap-3 text-neutral-600 dark:text-neutral-400">
                  <svg class="h-5 w-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <span>hello@vdrive.io</span>
                </li>
                <li class="flex items-center gap-3 text-neutral-600 dark:text-neutral-400">
                  <svg class="h-5 w-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>Bangalore, India</span>
                </li>
              </ul>

              <div class="mt-6 pt-6 border-t border-neutral-200 dark:border-neutral-800">
                <p class="text-sm text-neutral-600 dark:text-neutral-400">
                  For urgent support, existing customers can reach us via the in-app help center.
                </p>
              </div>
            </div>

            <!-- Enterprise CTA -->
            {plan === 'enterprise' && (
              <div class="rounded-2xl bg-gradient-to-r from-primary-600 to-accent-600 p-8 text-white">
                <h2 class="text-xl font-semibold">Enterprise Inquiry</h2>
                <p class="mt-2 text-primary-100">
                  Thank you for your interest in vDrive Enterprise. Our team will review your requirements and get back to you within 24 hours.
                </p>
                <ul class="mt-4 space-y-2 text-sm text-primary-100">
                  <li class="flex items-center gap-2">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Custom storage & limits
                  </li>
                  <li class="flex items-center gap-2">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Dedicated support & SLA
                  </li>
                  <li class="flex items-center gap-2">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Custom integrations & SSO
                  </li>
                </ul>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
