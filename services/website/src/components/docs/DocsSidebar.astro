---
/**
 * DocsSidebar Component
 * Sidebar navigation for documentation pages with section grouping.
 */

import { getCollection } from 'astro:content';

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;

const docs = (await getCollection('docs'))
  .filter((doc) => !doc.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// Group docs by section
const sections = docs.reduce(
  (acc, doc) => {
    const section = doc.data.section || 'General';
    if (!acc[section]) {
      acc[section] = [];
    }
    acc[section].push(doc);
    return acc;
  },
  {} as Record<string, typeof docs>
);

// Define section order
const sectionOrder = ['Getting Started', 'Galleries', 'AI Features', 'API Reference', 'General'];
const sortedSections = Object.entries(sections).sort(([a], [b]) => {
  const aIndex = sectionOrder.indexOf(a);
  const bIndex = sectionOrder.indexOf(b);
  if (aIndex === -1 && bIndex === -1) return a.localeCompare(b);
  if (aIndex === -1) return 1;
  if (bIndex === -1) return -1;
  return aIndex - bIndex;
});
---

<aside class="docs-sidebar lg:col-span-1">
  <nav class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto scrollbar-hide" aria-label="Documentation navigation">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-warm-400">
      Documentation
    </h2>

    <ul class="mt-4 space-y-6" role="list">
      {sortedSections.map(([section, items]) => (
        <li>
          <span class="block text-sm font-medium text-neutral-900 dark:text-white">
            {section}
          </span>
          <ul
            class="mt-2 ml-3 space-y-1 border-l border-neutral-200 dark:border-warm-800"
            role="list"
          >
            {items.map((doc) => {
              const isActive = doc.slug === currentSlug;
              return (
                <li>
                  <a
                    href={`/docs/${doc.slug}`}
                    class:list={[
                      'block py-1 pl-4 text-sm transition-colors',
                      'focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 rounded',
                      isActive
                        ? 'border-l-2 border-primary-500 -ml-px pl-[15px] font-medium text-primary-600 dark:text-primary-400'
                        : 'text-neutral-600 hover:text-neutral-900 dark:text-warm-400 dark:hover:text-white',
                    ]}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {doc.data.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </li>
      ))}
    </ul>

    {/* Quick Links */}
    <div class="mt-8 border-t border-neutral-200 pt-6 dark:border-warm-800">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-warm-400">
        Resources
      </h3>
      <ul class="mt-3 space-y-2" role="list">
        <li>
          <a
            href="/features"
            class="flex items-center gap-2 text-sm text-neutral-600 hover:text-neutral-900 dark:text-warm-400 dark:hover:text-white transition-colors"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Features
          </a>
        </li>
        <li>
          <a
            href="/pricing"
            class="flex items-center gap-2 text-sm text-neutral-600 hover:text-neutral-900 dark:text-warm-400 dark:hover:text-white transition-colors"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Pricing
          </a>
        </li>
        <li>
          <a
            href="/blog"
            class="flex items-center gap-2 text-sm text-neutral-600 hover:text-neutral-900 dark:text-warm-400 dark:hover:text-white transition-colors"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            Blog
          </a>
        </li>
      </ul>
    </div>
  </nav>
</aside>
