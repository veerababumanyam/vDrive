---
/**
 * Testimonials Section - 2026 Design
 * Mobile-first testimonials with:
 * - Real customer stories
 * - 5-star ratings with avatars
 * - Glassmorphism cards
 * - Scroll animations
 */

const testimonials = [
  {
    id: 1,
    name: 'Sarah Chen',
    role: 'Wedding Photographer',
    company: 'Sarah Chen Photography',
    avatar: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=150&h=150&fit=crop',
    rating: 5,
    content: 'vDrive completely transformed how I deliver photos to clients. The AI face recognition saved me 15+ hours on my last wedding. My clients love the modern gallery interface!',
    photos: '2,500+',
    highlight: 'Saves 15+ hours per wedding',
  },
  {
    id: 2,
    name: 'Marcus Rodriguez',
    role: 'Portrait Photographer',
    company: 'Rodriguez Studios',
    avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&h=150&fit=crop',
    rating: 5,
    content: 'The integrated invoicing feature is a game-changer. I get paid 40% faster now. The mobile app lets me manage galleries on the go between shoots.',
    photos: '5,000+',
    highlight: 'Gets paid 40% faster',
  },
  {
    id: 3,
    name: 'Emily Thompson',
    role: 'Event Photographer',
    company: 'Thompson Events',
    avatar: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=150&h=150&fit=crop',
    rating: 5,
    content: 'Unlimited storage means I never worry about space. The download analytics show me exactly which photos clients love. Best investment for my business!',
    photos: '10,000+',
    highlight: 'Unlimited storage included',
  },
  {
    id: 4,
    name: 'David Kim',
    role: 'Commercial Photographer',
    company: 'Kim Creative Co.',
    avatar: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=150&h=150&fit=crop',
    rating: 5,
    content: 'Client collaboration tools are incredible. They can comment directly on photos, making the selection process so much smoother. My clients feel more involved.',
    photos: '8,000+',
    highlight: 'Clients love collaboration features',
  },
  {
    id: 5,
    name: 'Jessica Martinez',
    role: 'Newborn Photographer',
    company: 'Sweet Moments Photography',
    avatar: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=150&h=150&fit=crop',
    rating: 5,
    content: 'The watermarking and download protection give me peace of mind. My clients appreciate the beautiful, professional galleries. It\'s elevated my brand!',
    photos: '3,500+',
    highlight: 'Professional watermarking',
  },
  {
    id: 6,
    name: 'Alex Turner',
    role: 'Sports Photographer',
    company: 'Action Shots Pro',
    avatar: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=150&h=150&fit=crop',
    rating: 5,
    content: 'Batch uploading hundreds of sports photos is effortless. The lightning-fast loading keeps my athlete clients happy. Worth every penny!',
    photos: '15,000+',
    highlight: 'Lightning-fast uploads',
  },
];

// Calculate average rating
const avgRating = (testimonials.reduce((acc, t) => acc + t.rating, 0) / testimonials.length).toFixed(1);
const totalTestimonials = 347; // Total number of reviews
---

<section id="testimonials" class="section relative overflow-hidden bg-neutral-50 dark:bg-warm-900/50">
  <!-- Background Pattern -->
  <div class="absolute inset-0 bg-grid-dots text-neutral-400 dark:text-warm-700"></div>

  <div class="container-lg relative">
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <!-- Rating Badge -->
      <div class="mb-6 inline-flex items-center gap-3 rounded-full glass-premium px-6 py-3 hover-lift">
        <div class="flex items-center gap-1">
          {[1, 2, 3, 4, 5].map((_) => (
            <svg class="h-5 w-5 fill-yellow-500" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-lg font-bold text-neutral-900 dark:text-white">{avgRating}</span>
        <span class="text-sm text-neutral-600 dark:text-warm-400">from {totalTestimonials} reviews</span>
      </div>

      <h2 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-4xl lg:text-5xl">
        Loved by photographers
        <span class="block mt-2 text-gradient-animated">worldwide</span>
      </h2>

      <p class="mt-4 text-lg text-neutral-600 dark:text-warm-300">
        Join thousands of professional photographers who trust vDrive to deliver exceptional client experiences.
      </p>
    </div>

    <!-- Enhanced Testimonials Grid - Photography-Inspired Cards -->
    <div class="mt-16 grid gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((testimonial, index) => (
        <article
          class="testimonial-card group relative overflow-hidden rounded-3xl glass-iridescent shadow-dramatic hover-magnetic-advanced scroll-fade-up p-8"
          style={`animation-delay: ${index * 100}ms`}
        >
          <!-- Photography-style light leak -->
          <div class="absolute top-0 right-0 w-1/2 h-1/2 bg-gradient-to-br from-primary-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 blur-3xl"></div>

          <!-- Quote icon with depth -->
          <div class="absolute -top-3 -right-3 text-primary-500/5 dark:text-primary-400/5 transition-all duration-500 group-hover:scale-110 group-hover:rotate-12">
            <svg class="h-32 w-32 drop-shadow-2xl" fill="currentColor" viewBox="0 0 32 32">
              <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
            </svg>
          </div>

          <!-- Star rating with sparkle effect -->
          <div class="mb-6 flex items-center gap-1">
            {Array.from({ length: 5 }).map((_, i) => (
              <div class="star-wrapper relative">
                <svg class={`h-6 w-6 fill-yellow-500 transition-all duration-300 group-hover:scale-110 ${i < testimonial.rating ? '' : 'opacity-30'}`} style={`transition-delay: ${i * 50}ms`} viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <!-- Sparkle overlay -->
                {i < testimonial.rating && (
                  <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" style={`transition-delay: ${i * 80}ms`}>
                    <svg class="h-6 w-6 fill-yellow-300 animate-pulse-slow" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  </div>
                )}
              </div>
            ))}
          </div>

          <!-- Testimonial content with animation -->
          <blockquote class="relative z-10 mb-8 text-lg text-neutral-700 dark:text-warm-200 leading-relaxed">
            <span class="inline-block animate-reveal-up">
              "{testimonial.content}"
            </span>
          </blockquote>

          <!-- Highlight badge with pulse -->
          <div class="mb-8 inline-flex items-center gap-2 rounded-full glass-premium px-4 py-2 shadow-depth-1 hover-glow-pulse">
            <div class="relative flex h-3 w-3">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary-400 opacity-75"></span>
              <span class="relative inline-flex h-3 w-3 rounded-full bg-primary-500"></span>
            </div>
            <span class="text-sm font-medium text-primary-700 dark:text-primary-400">
              {testimonial.highlight}
            </span>
          </div>

          <!-- Author info with depth -->
          <div class="flex items-center gap-4 border-t border-white/10 pt-6">
            <!-- Avatar with depth rings -->
            <div class="avatar-container relative">
              <!-- Glow ring -->
              <div class="absolute -inset-1 rounded-full gradient-cinematic-primary opacity-0 group-hover:opacity-50 blur-md transition-opacity duration-500"></div>

              <!-- Main avatar -->
              <img
                src={testimonial.avatar}
                alt={`${testimonial.name} avatar`}
                class="relative h-14 w-14 rounded-full object-cover ring-2 ring-white/10 shadow-depth-2 transition-all duration-300 group-hover:ring-4 group-hover:ring-primary-500/30 group-hover:scale-105"
                loading="lazy"
              />
            </div>

            <!-- Author details -->
            <div class="flex-1">
              <div class="font-bold text-neutral-900 dark:text-white group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-cinematic-primary transition-all duration-300">
                {testimonial.name}
              </div>
              <div class="text-sm text-neutral-600 dark:text-warm-400">
                {testimonial.role}
              </div>
              <div class="mt-1 flex items-center gap-2 text-xs text-neutral-500 dark:text-warm-500">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span>{testimonial.photos} photos delivered</span>
              </div>
            </div>
          </div>

          <!-- Depth shadow accent -->
          <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-2/3 h-8 bg-primary-500/10 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        </article>
      ))}
    </div>

    <!-- Bottom Trust Indicators -->
    <div class="mt-16 flex flex-col sm:flex-row items-center justify-center gap-8 text-center">
      <div class="flex items-center gap-3">
        <div class="flex -space-x-2">
          {testimonials.slice(0, 4).map((t) => (
            <img
              src={t.avatar}
              alt=""
              class="h-10 w-10 rounded-full border-2 border-white dark:border-warm-900 object-cover"
              loading="lazy"
            />
          ))}
        </div>
        <div class="text-left">
          <div class="font-semibold text-neutral-900 dark:text-white">10,000+ photographers</div>
          <div class="text-sm text-neutral-600 dark:text-warm-400">Trust vDrive daily</div>
        </div>
      </div>

      <div class="h-8 w-px bg-neutral-300 dark:bg-warm-700 hidden sm:block"></div>

      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-green-100 dark:bg-green-900/30">
          <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="text-left">
          <div class="font-semibold text-neutral-900 dark:text-white">99.9% uptime</div>
          <div class="text-sm text-neutral-600 dark:text-warm-400">Always available</div>
        </div>
      </div>

      <div class="h-8 w-px bg-neutral-300 dark:bg-warm-700 hidden sm:block"></div>

      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary-100 dark:bg-primary-900/30">
          <svg class="h-6 w-6 text-primary-600 dark:text-primary-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z" />
            <path d="M15 7v2a4 4 0 01-4 4H9.828l-1.766 1.767c.28.149.599.233.938.233h2l3 3v-3h2a2 2 0 002-2V9a2 2 0 00-2-2h-1z" />
          </svg>
        </div>
        <div class="text-left">
          <div class="font-semibold text-neutral-900 dark:text-white">24/7 support</div>
          <div class="text-sm text-neutral-600 dark:text-warm-400">We're here to help</div>
        </div>
      </div>
    </div>
  </div>
</section>
