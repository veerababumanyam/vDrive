---
import { pricingPlans } from '@/data/pricing';
import { formatINR } from '@/utils/currency';

const APP_URL = import.meta.env.APP_URL || 'https://app.RawDrive.io';

// For landing page, show 3 main plans (Starter, Professional, Business)
const displayPlans = pricingPlans.filter((plan) =>
  ['starter', 'professional', 'business'].includes(plan.id)
);
---

<section class="section bg-white dark:bg-warm-950" id="pricing">
  <div class="container-lg">
    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <span class="badge badge-primary">Pricing</span>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-4xl">
        Simple, transparent pricing
      </h2>
      <p class="mt-4 text-lg text-neutral-600 dark:text-warm-400">
        Choose the plan that fits your business. All plans include a 14-day free trial.
      </p>

      <!-- Billing Toggle -->
      <div class="mt-8 flex items-center justify-center gap-4">
        <span class="text-sm font-medium text-neutral-600 dark:text-warm-400" id="monthly-label">Monthly</span>
        <button
          type="button"
          id="billing-toggle"
          class="relative inline-flex h-6 w-11 items-center rounded-full bg-primary-500 transition-colors"
          role="switch"
          aria-checked="true"
          aria-label="Toggle between monthly and yearly billing"
        >
          <span class="sr-only">Toggle billing period</span>
          <span
            id="toggle-dot"
            class="inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform translate-x-6"
          ></span>
        </button>
        <span class="text-sm font-medium text-neutral-900 dark:text-white" id="yearly-label">
          Yearly
          <span class="ml-1 rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700 dark:bg-green-900/30 dark:text-green-400">
            Save 17%
          </span>
        </span>
      </div>
    </div>

    <!-- Pricing Cards -->
    <div class="mt-16 grid gap-8 lg:grid-cols-3">
      {displayPlans.map((plan) => (
        <div class={`relative rounded-2xl border p-8 ${plan.isPopular ? 'border-primary-500 shadow-lg shadow-primary-500/10' : 'border-neutral-200 dark:border-warm-800'}`}>
          {plan.isPopular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2">
              <span class="rounded-full bg-primary-500 px-4 py-1 text-sm font-medium text-white">
                Most Popular
              </span>
            </div>
          )}

          <div>
            <h3 class="text-xl font-semibold text-neutral-900 dark:text-white">
              {plan.name}
            </h3>
            <p class="mt-2 text-sm text-neutral-600 dark:text-warm-400">
              {plan.description}
            </p>
          </div>

          <div class="mt-6">
            <div class="flex items-baseline gap-1">
              <span class="text-4xl font-bold text-neutral-900 dark:text-white price-monthly" data-price={plan.priceINR}>
                {formatINR(plan.priceINR ?? 0)}
              </span>
              <span class="text-4xl font-bold text-neutral-900 dark:text-white price-yearly hidden" data-price={plan.priceINRAnnual ? Math.round(plan.priceINRAnnual / 12) : 0}>
                {formatINR(plan.priceINRAnnual ? Math.round(plan.priceINRAnnual / 12) : 0)}
              </span>
              <span class="text-neutral-500">/month</span>
            </div>
            <p class="mt-1 text-sm text-neutral-500 billing-note-yearly hidden" data-annual={plan.priceINRAnnual}>
              Billed annually ({formatINR(plan.priceINRAnnual ?? 0)}/year)
            </p>
          </div>

          <ul class="mt-8 space-y-4">
            {plan.features.slice(0, 7).map((feature) => (
              <li class="flex items-start gap-3">
                <svg class="h-5 w-5 flex-shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-neutral-600 dark:text-warm-400">
                  {feature}
                </span>
              </li>
            ))}
          </ul>

          <a
            href={`${APP_URL}${plan.ctaLink}`}
            class={`mt-8 block w-full rounded-lg py-3 text-center font-medium transition-colors ${plan.isPopular ? 'bg-primary-500 text-white hover:bg-primary-600' : 'bg-neutral-100 text-neutral-900 hover:bg-neutral-200 dark:bg-warm-800 dark:text-white dark:hover:bg-warm-700'}`}
          >
            {plan.ctaText}
          </a>
        </div>
      ))}
    </div>

    <!-- View All Plans Link -->
    <div class="mt-12 text-center">
      <a href="/pricing" class="text-primary-500 hover:text-primary-600 font-medium transition-colors">
        View all plans including Free and Enterprise
        <svg class="inline-block h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  function initPricingToggle() {
    const toggle = document.getElementById('billing-toggle');
    const toggleDot = document.getElementById('toggle-dot');
    const monthlyPrices = document.querySelectorAll('.price-monthly');
    const yearlyPrices = document.querySelectorAll('.price-yearly');
    const yearlyNotes = document.querySelectorAll('.billing-note-yearly');
    const monthlyLabel = document.getElementById('monthly-label');
    const yearlyLabel = document.getElementById('yearly-label');

    let isYearly = true;

    // Clean up existing listener to prevent duplicates on view transitions
    const handleToggle = () => {
      isYearly = !isYearly;

      // Update aria-checked for screen readers (WCAG compliance)
      toggle?.setAttribute('aria-checked', String(isYearly));

      if (isYearly) {
        toggleDot?.classList.add('translate-x-6');
        toggleDot?.classList.remove('translate-x-1');
        monthlyPrices.forEach((el) => el.classList.add('hidden'));
        yearlyPrices.forEach((el) => el.classList.remove('hidden'));
        yearlyNotes.forEach((el) => el.classList.remove('hidden'));
        monthlyLabel?.classList.remove('text-neutral-900', 'dark:text-white');
        monthlyLabel?.classList.add('text-neutral-600', 'dark:text-warm-400');
        yearlyLabel?.classList.add('text-neutral-900', 'dark:text-white');
        yearlyLabel?.classList.remove('text-neutral-600', 'dark:text-warm-400');
      } else {
        toggleDot?.classList.remove('translate-x-6');
        toggleDot?.classList.add('translate-x-1');
        monthlyPrices.forEach((el) => el.classList.remove('hidden'));
        yearlyPrices.forEach((el) => el.classList.add('hidden'));
        yearlyNotes.forEach((el) => el.classList.add('hidden'));
        monthlyLabel?.classList.add('text-neutral-900', 'dark:text-white');
        monthlyLabel?.classList.remove('text-neutral-600', 'dark:text-warm-400');
        yearlyLabel?.classList.remove('text-neutral-900', 'dark:text-white');
        yearlyLabel?.classList.add('text-neutral-600', 'dark:text-warm-400');
      }
    };

    toggle?.addEventListener('click', handleToggle);
  }

  // Initialize on page load
  initPricingToggle();

  // Re-initialize on Astro view transitions
  document.addEventListener('astro:after-swap', initPricingToggle);
</script>
