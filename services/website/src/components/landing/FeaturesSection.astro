---
import { features } from '@/data/features';

// Map Lucide icon names to SVG paths
const iconPaths: Record<string, string> = {
  Sparkles: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />`,
  Users: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
  BookImage: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5V6.5A2.5 2.5 0 016.5 4H20v13H6.5c-1.38 0-2.5 1.12-2.5 2.5zM8 8l4 4 4-4" />`,
  ScanFace: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  Contact: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`,
  CloudUpload: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15zm9-7v6m-3-3l3-3 3 3" />`,
};
---

<section class="section bg-neutral-50 dark:bg-warm-900">
  <div class="container-lg">
    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <span class="badge badge-primary">Features</span>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-4xl">
        Everything you need to run your photography business
      </h2>
      <p class="mt-4 text-lg text-neutral-600 dark:text-warm-400">
        From photo management to client delivery, vDrive has you covered with powerful tools designed for professional photographers.
      </p>
    </div>

    <!-- Enhanced Feature Grid with Staggered Reveals -->
    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature, index) => (
        <article
          class="feature-card group relative overflow-hidden rounded-2xl glass-ultra shadow-depth-2 hover-magnetic-advanced hover-shimmer scroll-fade-up p-6"
          style={`animation-delay: ${index * 150}ms`}
          data-index={index}
        >
          <!-- Gradient background shift on hover -->
          <div class="absolute inset-0 bg-gradient-to-br from-primary-500/0 to-accent-500/0 group-hover:from-primary-500/10 group-hover:to-accent-500/5 transition-all duration-700"></div>

          <!-- Icon container with morphing background -->
          <div class="relative mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-100 to-primary-50 dark:from-primary-900/40 dark:to-primary-900/20 transition-all duration-500 group-hover:scale-110 group-hover:rotate-6 shadow-depth-1 group-hover:shadow-glow-primary">
            <!-- Morphing gradient overlay -->
            <div class="absolute inset-0 rounded-2xl gradient-cinematic-primary opacity-0 group-hover:opacity-20 transition-opacity duration-500 animate-morph-sophisticated"></div>

            <!-- Icon with color transition -->
            <svg class="h-8 w-8 relative z-10 text-primary-600 dark:text-primary-400 group-hover:text-white transition-all duration-300 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <Fragment set:html={iconPaths[feature.icon] || iconPaths.Sparkles} />
            </svg>

            <!-- Glow effect -->
            <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-glow-primary"></div>
          </div>

          <!-- Content -->
          <div class="relative z-10">
            <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-3 group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-cinematic-primary transition-all duration-300">
              {feature.name}
            </h3>
            <p class="text-neutral-600 dark:text-warm-400 leading-relaxed">
              {feature.tagline}
            </p>
          </div>

          <!-- Hover border accent -->
          <div class="absolute inset-0 rounded-2xl border border-white/0 group-hover:border-white/10 transition-all duration-300 pointer-events-none"></div>

          <!-- Corner accents -->
          <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-br from-accent-500/0 to-transparent group-hover:from-accent-500/10 transition-all duration-700 blur-2xl"></div>
        </article>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-16 text-center">
      <a href="/features" class="btn btn-primary">
        Explore all features
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>
