---
/**
 * Hero Section - 2026 Design
 * High-conversion landing page hero with:
 * - Aurora animated background
 * - Glassmorphism elements
 * - Trust badges
 * - Animated CTAs
 */
const APP_URL = import.meta.env.APP_URL || 'https://app.vdrive.io';
---

<section class="relative min-h-[90vh] overflow-hidden bg-white dark:bg-warm-950">
  <!-- Multi-Layer Cinematic Background -->
  <div class="absolute inset-0 overflow-hidden">
    <!-- Base gradient with depth - theme aware -->
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-50 via-white to-neutral-50 dark:from-warm-950 dark:via-warm-900 dark:to-warm-950"></div>

    <!-- Depth overlay - lighter for light mode -->
    <div class="absolute inset-0 opacity-50 dark:opacity-100">
      <div class="absolute inset-0 gradient-depth-overlay"></div>
    </div>

    <!-- Animated mesh gradient (parallax) -->
    <div class="absolute inset-0 animate-parallax-float opacity-40">
      <div class="absolute -top-1/3 -left-1/4 w-2/3 h-2/3 rounded-full bg-primary-500/20 blur-[150px]"></div>
      <div class="absolute top-1/4 right-0 w-1/2 h-1/2 rounded-full bg-accent-500/15 blur-[120px] animate-morph-sophisticated"></div>
      <div class="absolute -bottom-1/4 left-1/3 w-1/2 h-1/2 rounded-full bg-violet-500/10 blur-[140px]"></div>
    </div>

    <!-- Light leak overlay -->
    <div class="absolute inset-0 gradient-light-leak pointer-events-none"></div>

    <!-- Lens flare effect -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
      <div class="absolute w-1/3 h-full bg-gradient-to-r from-transparent via-white/5 to-transparent skew-x-12 animate-lens-flare"></div>
    </div>

    <!-- Photography vignette -->
    <div class="absolute inset-0 gradient-photography-vignette pointer-events-none"></div>

    <!-- Floating particles container -->
    <div class="particles-container absolute inset-0 pointer-events-none"></div>
  </div>

  <div class="container-lg relative section-lg">
    <div class="mx-auto max-w-4xl text-center">
      <!-- Trust Badge -->
      <div class="mb-8 inline-flex items-center gap-3 rounded-full glass-premium px-5 py-2.5 hover-lift">
        <span class="relative flex h-2.5 w-2.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-500"></span>
        </span>
        <span class="text-sm font-medium text-neutral-700 dark:text-warm-200">
          Trusted by 10,000+ photographers worldwide
        </span>
        <div class="flex -space-x-1.5">
          {[1, 2, 3, 4].map((_) => (
            <div class="h-6 w-6 rounded-full border-2 border-white dark:border-warm-800 bg-gradient-to-br from-primary-400 to-accent-400" />
          ))}
        </div>
      </div>

      <!-- Headline -->
      <h1 class="text-balance text-4xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-5xl lg:text-6xl xl:text-7xl">
        Professional Photography
        <span class="block mt-2 text-gradient-animated">Client Galleries</span>
        <span class="block mt-2">Made Simple</span>
      </h1>

      <!-- Subheadline -->
      <p class="mt-8 text-balance text-lg text-neutral-600 dark:text-warm-300 sm:text-xl max-w-2xl mx-auto">
        Store unlimited photos, create stunning galleries, and get paid faster with integrated invoicing.
        The all-in-one platform that saves you 10+ hours every week.
      </p>

      <!-- Premium CTA Buttons -->
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <!-- Primary CTA with Advanced Effects -->
        <a
          href={`${APP_URL}/sign-up`}
          class="btn btn-primary btn-lg btn-glow hover-magnetic-advanced hover-shimmer group relative overflow-hidden"
        >
          <!-- Animated gradient background -->
          <div class="absolute inset-0 gradient-cinematic-primary animate-gradient-shift opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

          <!-- Ripple effect container -->
          <div class="ripple-effect absolute inset-0"></div>

          <!-- Button content -->
          <span class="relative z-10 flex items-center gap-2">
            Start Free Trial
            <svg class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </span>

          <!-- Border glow -->
          <div class="absolute inset-0 rounded-lg border border-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </a>

        <!-- Secondary CTA with Glass Effect -->
        <a href="#features" class="btn btn-outline btn-lg glass-iridescent hover-magnetic-advanced hover-glow-pulse group">
          <span class="flex items-center gap-2">
            <svg class="h-5 w-5 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Watch Demo
          </span>
        </a>
      </div>

      <!-- Trust Indicators -->
      <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-6 text-sm text-neutral-500 dark:text-warm-400">
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>14-day free trial</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>No credit card required</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Cancel anytime</span>
        </div>
      </div>
    </div>

    <!-- Hero Dashboard Preview -->
    <div class="relative mt-16 lg:mt-24 perspective-container">
      <!-- Multi-layer glow -->
      <div class="absolute -inset-8 rounded-3xl bg-gradient-to-r from-primary-500/30 via-accent-500/20 to-violet-500/30 blur-3xl animate-glow-pulse"></div>
      <div class="absolute -inset-4 rounded-3xl bg-gradient-to-r from-primary-500/20 via-transparent to-accent-500/20 blur-2xl"></div>

      <!-- Dashboard Card with Premium Effects -->
      <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl glass-ultra shadow-dramatic hover-perspective-tilt hover-border-animate group">
        <!-- Enhanced Browser Chrome with Depth -->
        <div class="flex items-center gap-2 px-4 py-3 border-b border-white/10 bg-gradient-to-b from-white/5 to-transparent backdrop-blur-xl shadow-depth-1">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <div class="flex-1 mx-4">
            <div class="bg-neutral-200/50 dark:bg-warm-800/50 rounded-lg px-4 py-1.5 text-xs text-neutral-500 dark:text-warm-400 text-center">
              app.vdrive.io/galleries
            </div>
          </div>
        </div>

        <!-- Dashboard Content with Parallax Layers -->
        <div class="aspect-[16/9] w-full relative overflow-hidden">
          <!-- Background layer (blur) -->
          <div class="absolute inset-0 bg-gradient-to-br from-neutral-50 to-neutral-100 dark:from-warm-950 dark:to-warm-900 filter blur-[2px] scale-105"></div>

          <!-- Mid layer (sidebar + interface) -->
          <div class="absolute inset-0 flex transition-transform duration-700 group-hover:translate-y-[-2px]">
            <!-- Sidebar -->
            <div class="hidden sm:block w-16 lg:w-52 bg-white dark:bg-warm-900 border-r border-neutral-200 dark:border-warm-800 p-3 lg:p-4 shadow-[2px_0_8px_rgba(0,0,0,0.08)]">
              <div class="space-y-2">
                <!-- Home -->
                <div class="flex items-center gap-3 px-2 lg:px-3 py-2.5 rounded-lg bg-primary-500/10 border border-primary-500/20">
                  <svg class="w-5 h-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
                  <span class="hidden lg:block text-sm font-medium text-primary-600 dark:text-primary-400">Galleries</span>
                </div>
                <!-- Photos -->
                <div class="flex items-center gap-3 px-2 lg:px-3 py-2.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-warm-800/50 transition-colors">
                  <svg class="w-5 h-5 text-neutral-500 dark:text-warm-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span class="hidden lg:block text-sm text-neutral-600 dark:text-warm-300">Photos</span>
                </div>
                <!-- Clients -->
                <div class="flex items-center gap-3 px-2 lg:px-3 py-2.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-warm-800/50 transition-colors">
                  <svg class="w-5 h-5 text-neutral-500 dark:text-warm-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                  <span class="hidden lg:block text-sm text-neutral-600 dark:text-warm-300">Clients</span>
                </div>
                <!-- Settings -->
                <div class="flex items-center gap-3 px-2 lg:px-3 py-2.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-warm-800/50 transition-colors">
                  <svg class="w-5 h-5 text-neutral-500 dark:text-warm-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="hidden lg:block text-sm text-neutral-600 dark:text-warm-300">Settings</span>
                </div>
              </div>
            </div>

            <!-- Main Content Area -->
            <div class="flex-1 p-3 sm:p-4 lg:p-6">
              <!-- Header -->
              <div class="flex items-center justify-between mb-4">
                <div>
                  <h3 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white">My Galleries</h3>
                  <p class="text-xs text-neutral-500 dark:text-warm-400 mt-0.5">24 galleries • 1,248 photos</p>
                </div>
                <button class="hidden sm:flex items-center gap-2 px-3 py-1.5 sm:px-4 sm:py-2 rounded-lg bg-primary-500 text-white text-xs sm:text-sm font-medium shadow-[0_4px_14px_rgba(37,99,235,0.4)] hover:shadow-[0_6px_20px_rgba(37,99,235,0.5)] hover:bg-primary-600 transition-all">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                  <span class="hidden sm:inline">New Gallery</span>
                </button>
              </div>

              <!-- Photo Grid -->
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-3 lg:gap-4">
                {[
                  { img: 'https://images.unsplash.com/photo-1519741497674-611481863552?w=400&h=400&fit=crop', count: '156', delay: '0ms' },
                  { img: 'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=400&h=400&fit=crop', count: '89', delay: '100ms' },
                  { img: 'https://images.unsplash.com/photo-1606216794074-735e91aa2c92?w=400&h=400&fit=crop', count: '234', delay: '200ms' },
                  { img: 'https://images.unsplash.com/photo-1502823403499-6ccfcf4fb453?w=400&h=400&fit=crop', count: null, delay: '300ms' },
                  { img: 'https://images.unsplash.com/photo-1523438885200-e635ba2c371e?w=400&h=400&fit=crop', count: null, delay: '400ms' },
                  { img: 'https://images.unsplash.com/photo-1522673607200-164d1b6ce486?w=400&h=400&fit=crop', count: null, delay: '500ms' },
                  { img: 'https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=400&h=400&fit=crop', count: null, delay: '600ms' },
                  { img: 'https://images.unsplash.com/photo-1469371670807-013ccf25f16a?w=400&h=400&fit=crop', count: null, delay: '700ms' },
                ].map((photo) => (
                  <div
                    class="group relative aspect-square rounded-lg overflow-hidden cursor-pointer shadow-[0_2px_8px_rgba(0,0,0,0.12)] hover:shadow-[0_8px_30px_rgba(0,0,0,0.24)] hover:-translate-y-1 transition-all duration-300"
                    style={`animation-delay: ${photo.delay}`}
                  >
                    {/* Photo image */}
                    <img
                      src={photo.img}
                      alt="Gallery photo"
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />

                    {/* Subtle gradient overlay */}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>

                    {/* Hover overlay */}
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
                      <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-white/30 backdrop-blur-sm flex items-center justify-center">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                      </div>
                    </div>

                    {/* Photo count badge */}
                    {photo.count && (
                      <div class="absolute top-2 right-2 px-2 py-0.5 rounded-full bg-black/50 backdrop-blur-sm text-white text-xs font-medium">
                        {photo.count}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Foreground glow highlights -->
          <div class="absolute inset-0 pointer-events-none bg-gradient-to-t from-transparent via-transparent to-white/5"></div>
        </div>
      </div>

      <!-- Depth accent shadows -->
      <div class="absolute -bottom-8 left-1/2 -translate-x-1/2 w-3/4 h-8 bg-primary-500/20 blur-3xl"></div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce-slow">
      <svg class="h-6 w-6 text-neutral-400 dark:text-warm-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>

<script>
  // Particle System for Hero Section
  function initHeroParticles() {
    const container = document.querySelector('.particles-container');
    if (!container) return;

    const particleCount = 20;

    for (let i = 0; i < particleCount; i++) {
      const particle = document.createElement('div');
      const size = Math.random() * 4 + 2; // 2-6px
      const startX = Math.random() * 100; // 0-100%
      const driftX = (Math.random() - 0.5) * 2; // -1 to 1
      const duration = Math.random() * 20 + 15; // 15-35s
      const delay = Math.random() * 5; // 0-5s

      particle.style.cssText = `
        position: absolute;
        width: ${size}px;
        height: ${size}px;
        background: radial-gradient(circle, rgba(14, 165, 233, 0.6), transparent);
        border-radius: 50%;
        left: ${startX}%;
        bottom: -10px;
        pointer-events: none;
        animation: particle-float ${duration}s linear infinite;
        animation-delay: ${delay}s;
        --drift-x: ${driftX};
        filter: blur(1px);
      `;

      container.appendChild(particle);
    }
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroParticles);
  } else {
    initHeroParticles();
  }

  // Re-initialize on Astro view transitions
  document.addEventListener('astro:after-swap', initHeroParticles);
</script>

<!-- Stats Section -->
<section class="relative py-12 border-y border-neutral-200 dark:border-warm-800 bg-neutral-50/50 dark:bg-warm-900/50">
  <div class="container-lg">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-bold text-neutral-900 dark:text-white">10K+</div>
        <div class="mt-1 text-sm text-neutral-600 dark:text-warm-400">Active Photographers</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-bold text-neutral-900 dark:text-white">50M+</div>
        <div class="mt-1 text-sm text-neutral-600 dark:text-warm-400">Photos Delivered</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-bold text-neutral-900 dark:text-white">99.9%</div>
        <div class="mt-1 text-sm text-neutral-600 dark:text-warm-400">Uptime SLA</div>
      </div>
      <div class="text-center">
        <div class="flex items-center justify-center gap-1">
          <div class="text-3xl sm:text-4xl font-bold text-neutral-900 dark:text-white">4.9</div>
          <svg class="h-6 w-6 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        </div>
        <div class="mt-1 text-sm text-neutral-600 dark:text-warm-400">Average Rating</div>
      </div>
    </div>
  </div>
</section>
