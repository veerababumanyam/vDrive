---
const APP_URL = import.meta.env.APP_URL || 'https://app.vdrive.io';
---

<section class="relative overflow-hidden bg-white dark:bg-warm-950">
  <!-- Background Pattern -->
  <div class="absolute inset-0 bg-hero-pattern opacity-50 dark:opacity-20"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/50 to-white dark:via-neutral-950/50 dark:to-neutral-950"></div>

  <div class="container-lg relative section-lg">
    <div class="mx-auto max-w-4xl text-center">
      <!-- Badge -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-primary-200 bg-primary-50 px-4 py-1.5 dark:border-primary-800 dark:bg-primary-900/30">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-primary-500"></span>
        </span>
        <span class="text-sm font-medium text-primary-700 dark:text-primary-300">
          Now with AI-powered face recognition
        </span>
      </div>

      <!-- Headline -->
      <h1 class="text-balance text-4xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-5xl lg:text-6xl">
        Professional Photography Client Galleries
        <span class="gradient-text">Made Simple</span>
      </h1>

      <!-- Subheadline -->
      <p class="mt-6 text-balance text-lg text-neutral-600 dark:text-warm-400 sm:text-xl">
        Share, deliver, and sell your photos with AI-powered galleries. No technical
        skills needed. Join 2,500+ photographers who save hours every week.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={`${APP_URL}/sign-up`} class="btn btn-primary btn-lg">
          Start Free Trial
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a href="/features" class="btn btn-outline btn-lg">
          See all features
        </a>
      </div>

      <!-- Social Proof -->
      <div class="mt-12 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <div class="flex -space-x-2">
          {[1, 2, 3, 4, 5].map((_) => (
            <div class="h-10 w-10 rounded-full border-2 border-white bg-gradient-to-br from-primary-400 to-accent-400 dark:border-warm-900" />
          ))}
        </div>
        <div class="text-sm text-neutral-600 dark:text-warm-400">
          <span class="font-semibold text-neutral-900 dark:text-white">2,500+</span>
          photographers trust vDrive
        </div>
      </div>
    </div>

    <!-- Hero Image -->
    <div class="relative mt-16 lg:mt-20">
      <div class="absolute -inset-4 rounded-3xl bg-gradient-to-r from-primary-500/20 via-accent-500/20 to-primary-500/20 blur-3xl"></div>
      <div class="relative overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-2xl dark:border-warm-800 dark:bg-warm-900">
        <div class="aspect-video w-full bg-gradient-to-br from-neutral-100 to-neutral-200 dark:from-neutral-800 dark:to-neutral-900">
          <!-- Placeholder for actual screenshot -->
          <div class="flex h-full items-center justify-center">
            <div class="text-center">
              <svg class="mx-auto h-16 w-16 text-neutral-300 dark:text-warm-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="mt-2 text-sm text-neutral-400 dark:text-warm-500">
                Dashboard Preview
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
