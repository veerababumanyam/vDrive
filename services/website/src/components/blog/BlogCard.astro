---
/**
 * BlogCard Component
 * Displays a blog post preview with image, title, excerpt, and metadata.
 */

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  image?: string;
  author: string;
  tags: string[];
  readingTime?: string;
}

const {
  title,
  description,
  slug,
  pubDate,
  image,
  author,
  tags,
  readingTime,
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="card-hover group">
  <a href={`/blog/${slug}`} class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 rounded-xl">
    {/* Image */}
    {image ? (
      <div class="aspect-video w-full overflow-hidden rounded-lg bg-neutral-100 dark:bg-warm-800">
        <img
          src={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="aspect-video w-full rounded-lg bg-gradient-to-br from-primary-100 to-accent-100 dark:from-primary-900/30 dark:to-accent-900/30 flex items-center justify-center">
        <svg
          class="h-12 w-12 text-primary-300 dark:text-primary-700"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
          />
        </svg>
      </div>
    )}

    {/* Content */}
    <div class="mt-4">
      {/* Tags */}
      <div class="flex flex-wrap gap-2">
        {tags.slice(0, 3).map((tag) => (
          <span class="text-xs font-medium text-primary-600 dark:text-primary-400">
            #{tag}
          </span>
        ))}
      </div>

      {/* Title */}
      <h2 class="mt-2 text-xl font-semibold text-neutral-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
        {title}
      </h2>

      {/* Excerpt */}
      <p class="mt-2 line-clamp-2 text-neutral-600 dark:text-warm-400">
        {description}
      </p>

      {/* Meta */}
      <div class="mt-4 flex items-center gap-3 text-sm text-neutral-500 dark:text-warm-400">
        <span>{author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>
          {formattedDate}
        </time>
        {readingTime && (
          <>
            <span aria-hidden="true">·</span>
            <span>{readingTime}</span>
          </>
        )}
      </div>
    </div>
  </a>
</article>
