  'cloud': [{ d: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z' }],
  'cloud-upload': [{ d: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15zm9-7v6m-3-3l3-3 3 3' }],
  'user': [{ d: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' }],
  'check': [{ d: 'M5 13l4 4L19 7' }],
  'chevron-right': [{ d: 'M9 5l7 7-7 7' }],
  'chevron-down': [{ d: 'M19 9l-7 7-7-7' }],
  'arrow-right': [{ d: 'M13 7l5 5m0 0l-5 5m5-5H6' }],
  'arrow-left': [{ d: 'M10 19l-7-7m0 0l7-7m-7 7h18' }],
  'home': [{ d: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' }],
  'sun': [{ d: 'M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z' }],
  'moon': [{ d: 'M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z' }],
  'monitor': [{ d: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' }],
  'menu': [{ d: 'M4 6h16M4 12h16M4 18h16' }],
  'x': [{ d: 'M6 18L18 6M6 6l12 12' }],
  'search': [{ d: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z' }],
  'external-link': [{ d: 'M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14' }],
  'plus': [{ d: 'M12 4v16m8-8H4' }],
  'minus': [{ d: 'M20 12H4' }],
};

// Get path data for the icon (returns empty array if not found)
const paths = iconPaths[name] || [];
---

{paths.length > 0 ? (
  <svg
    class:list={[sizeClasses[size], className]}
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    {paths.map((path) => (
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d={path.d}
        fill-rule={path.fillRule}
      />
    ))}
  </svg>
) : (
  <span class="sr-only">Icon not found: {name}</span>
)}
