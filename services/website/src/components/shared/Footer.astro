---

<footer class="border-t border-neutral-200 bg-neutral-50 dark:border-warm-800 dark:bg-warm-900 transition-colors duration-200">
  <div class="container-lg py-12 lg:py-16">
    <!-- Newsletter Section -->
    <div class="mb-12 rounded-2xl bg-gradient-to-r from-primary-500 to-accent-500 p-8 text-white lg:p-12">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-2xl font-bold lg:text-3xl">
          Stay updated with vDrive
        </h2>
        <p class="mt-2 text-primary-100">
          Get photography tips, product updates, and exclusive offers delivered to your inbox.
        </p>
        <form class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center" id="newsletter-form">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            type="email"
            id="newsletter-email"
            name="email"
            placeholder="Enter your email"
            required
            class="w-full rounded-lg border-0 px-4 py-3 text-neutral-900 placeholder-neutral-500 focus:ring-2 focus:ring-white sm:w-72"
          />
          <button
            type="submit"
            class="rounded-lg bg-white px-6 py-3 font-semibold text-primary-600 transition-colors hover:bg-primary-50 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-500"
          >
            Subscribe
          </button>
        </form>
        <p class="mt-3 text-xs text-primary-200">
          No spam, unsubscribe anytime. Read our <a href="/privacy" class="underline hover:text-white">Privacy Policy</a>.
        </p>
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-6">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2" aria-label="vDrive Home">
          <svg
            class="h-8 w-8 text-primary-500"
            viewBox="0 0 32 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect width="32" height="32" rx="8" fill="currentColor" />
            <path
              d="M8 12L16 8L24 12V20L16 24L8 20V12Z"
              stroke="white"
              stroke-width="2"
              fill="none"
            />
            <circle cx="16" cy="16" r="3" fill="white" />
          </svg>
          <span class="text-xl font-bold text-neutral-900 dark:text-white">
            vDrive
          </span>
        </a>
        <p class="mt-4 max-w-xs text-sm text-neutral-600 dark:text-warm-400">
          Professional Photography Client Galleries Made Simple. Share, deliver, and sell your photos with AI-powered galleries.
        </p>
        <div class="mt-6 flex gap-4">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                class="text-neutral-400 hover:text-neutral-600 dark:hover:text-warm-300 transition-colors"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <Fragment set:html={socialIcons[social.name] || ''} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Links -->
      {
        footerNav.map((section) => (
          <div>
            <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">
              {section.title}
            </h3>
            <ul class="mt-4 space-y-3" role="list">
              {section.items.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-neutral-600 hover:text-neutral-900 dark:text-warm-400 dark:hover:text-white transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-neutral-200 pt-8 dark:border-warm-800 sm:flex-row">
      <p class="text-sm text-neutral-500 dark:text-warm-400">
        &copy; {currentYear} vDrive. All rights reserved. Made in India.
      </p>
      <div class="flex flex-wrap justify-center gap-6">
        <a
          href="/privacy"
          class="text-sm text-neutral-500 hover:text-neutral-700 dark:text-warm-400 dark:hover:text-warm-300 transition-colors"
        >
          Privacy
        </a>
        <a
          href="/terms"
          class="text-sm text-neutral-500 hover:text-neutral-700 dark:text-warm-400 dark:hover:text-warm-300 transition-colors"
        >
          Terms
        </a>
        <a
          href="/cookies"
          class="text-sm text-neutral-500 hover:text-neutral-700 dark:text-warm-400 dark:hover:text-warm-300 transition-colors"
        >
          Cookies
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  function initNewsletterForm() {
    const form = document.getElementById('newsletter-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form as HTMLFormElement);
      const email = formData.get('email');

      // In production, this would submit to a backend endpoint
      // For now, just show a success message
      alert(`Thanks for subscribing! We'll send updates to ${email}`);
      (form as HTMLFormElement).reset();
    });
  }

  // Initialize on page load
  initNewsletterForm();

  // Re-initialize on Astro view transitions
  document.addEventListener('astro:after-swap', initNewsletterForm);
</script>
