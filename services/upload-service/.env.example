# ===========================================
# RawDrive Upload Service Environment Variables
# ===========================================
# Copy this file to .env and update values for your environment
# For full environment reference, see: infrastructure/docker/.env.example

# Service Identity
SERVICE_NAME=upload-service
SERVICE_VERSION=1.0.0
APP_ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8008
API_BASE_URL=http://localhost:8008

# Database Configuration
DATABASE_URL=postgresql+asyncpg://RawDrive:RawDrive_dev_password@postgres:5432/RawDrive
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_MAX_LIFETIME_SEC=1800
DB_ECHO=false

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=RawDrive
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_ALGORITHM=HS256

# Encryption Configuration
ENCRYPTION_MASTER_KEY=your_32_byte_encryption_key_here

# TUS Upload Configuration
TUS_MAX_SIZE=10737418240
TUS_UPLOAD_URL_TTL_HOURS=24
MAX_CONCURRENT_UPLOADS_PER_WORKSPACE=10

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
