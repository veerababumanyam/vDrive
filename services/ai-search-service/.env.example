# ===========================================
# RawDrive AI Search Service Environment Variables
# ===========================================
# Copy this file to .env and update values for your environment
# For full environment reference, see: infrastructure/docker/.env.example

# Service Identity
SERVICE_NAME=ai-search-service
SERVICE_VERSION=1.0.0
APP_ENV=development
PORT=8009

# Database
DATABASE_URL=postgresql+asyncpg://RawDrive:RawDrive_dev_password@postgres:5432/RawDrive

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_ID=ai-search-service-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false

# CLIP Model Configuration
CLIP_MODEL=clip-ViT-L-14
CLIP_EMBEDDING_DIMENSION=1536
CLIP_MAX_BATCH_SIZE=32

# Gemini LLM Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# RAG Configuration
RAG_MAX_CONTEXT_PHOTOS=10
RAG_SIMILARITY_THRESHOLD=0.7

# Search Configuration
SEARCH_DEFAULT_LIMIT=50
SEARCH_MAX_LIMIT=200

# Caption Configuration
CAPTION_MAX_LENGTH=500

# Observability
SENTRY_DSN=
PROMETHEUS_ENABLED=true
