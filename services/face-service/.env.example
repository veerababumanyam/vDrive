# ===========================================
# RawDrive Face Service Environment Variables
# ===========================================
# Copy this file to .env and update values for your environment
# For full environment reference, see: infrastructure/docker/.env.example

# Service Identity
SERVICE_NAME=face-service
SERVICE_VERSION=1.0.0
APP_ENV=development
PORT=8002

# Database
DATABASE_URL=postgresql+asyncpg://RawDrive:RawDrive_dev_password@postgres:5432/RawDrive

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECT_TIMEOUT=5
REDIS_READ_TIMEOUT=10

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_ID=face-service-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false

# Google Cloud Vision (Face Detection)
# Set GOOGLE_CLOUD_VISION_ENABLED=true to enable
GOOGLE_CLOUD_VISION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_VISION_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_VISION_ENABLED=false

# Face Detection Configuration
FACE_DETECTION_RATE_LIMIT_PER_MINUTE=60
FACE_DETECTION_MIN_CONFIDENCE=0.7
FACE_EMBEDDING_DIMENSION=512

# Clustering Configuration (DBSCAN)
DBSCAN_EPS=0.5
DBSCAN_MIN_SAMPLES=2

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Observability
SENTRY_DSN=
PROMETHEUS_ENABLED=true
