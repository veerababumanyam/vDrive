# ============================================
# FastAPI Backend (python) Settings
# Mirrors backend/src/app/config/settings.py fail-fast configuration
# ============================================
APP_NAME=vDrive Backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# API_BASE_URL: Base URL for upload URLs returned by the backend
# For local development, use localhost. In production, use your domain.
API_BASE_URL=http://localhost:8000
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_MAX_LIFETIME_SEC=1800
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
# File paths to EdDSA keypair (Docker internal paths)
# These paths are mounted by Docker Compose from backend/secrets/ directory
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key
JWT_ALGORITHM=EdDSA
# CORS origins for backend (JSON array). Keep in sync with CORS_ORIGIN list above.
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:3002","http://localhost:8000","https://vDrive.in","https://www.vDrive.in","https://vDrive.ai","https://www.vDrive.ai","https://vDrive.de","https://www.vDrive.de"]

